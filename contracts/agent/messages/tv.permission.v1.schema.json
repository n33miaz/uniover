{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.permission.v1.schema.json",
  "title": "tv.permission.v1",
  "description": "Agente para API: o estado da permissão do UniOver na TV Samsung. 'needed': a TV não reconhece mais o UniOver (permissão revogada ou vencida) e o agente parou de tentar, sem pedir de novo em silêncio. 'granted': a TV aceitou. Sai quando o estado muda e de novo depois de cada hello; correlationId é nulo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "tv.permission.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "at"
      ],
      "properties": {
        "state": {
          "enum": [
            "needed",
            "granted"
          ]
        },
        "at": {
          "$ref": "../envelope.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
