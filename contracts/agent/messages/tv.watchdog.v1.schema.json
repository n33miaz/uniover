{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.watchdog.v1.schema.json",
  "title": "tv.watchdog.v1",
  "description": "Agente para API: evento do vigia que mantém o controle remoto da TV de pé.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.watchdog.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "severity", "detail", "attempts", "at"],
      "properties": {
        "kind": { "enum": ["port_closed", "repair_started", "repaired", "repair_failed", "adb_unreachable", "recovered"] },
        "severity": { "enum": ["info", "warn", "error"] },
        "detail": { "type": "string", "maxLength": 200 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "at": { "$ref": "../envelope.schema.json#/$defs/timestamp" }
      }
    }
  }
}
