{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.discovery.v1.schema.json",
  "title": "tv.discovery.v1",
  "description": "Agente para API: as TVs compatíveis que o agente achou na rede local dele. Sai antes do command.result.v1 de tv.discover.v1 (correlationId = id do comando) e repete o requestId. Nunca leva endereço IP nem MAC: 'id' é opaco e estável (derivado do identificador da TV) e 'controlled' diz se é a TV que este agente já controla.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "tv.discovery.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "tvs",
        "at"
      ],
      "properties": {
        "requestId": {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        "tvs": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "name",
              "controlled"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              "kind": {
                "enum": [
                  "android",
                  "samsung"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 60
              },
              "controlled": {
                "type": "boolean"
              }
            }
          }
        },
        "at": {
          "$ref": "../envelope.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
