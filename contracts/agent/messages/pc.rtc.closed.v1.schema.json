{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.rtc.closed.v1.schema.json",
  "title": "pc.rtc.closed.v1",
  "description": "Agente para API: o canal direto da sessão fechou, com o motivo (a API grava a trilha). `tvKeys` e `tvTexts` (opcionais, só de um canal com o escopo `tv`) contam as teclas e os textos da TV que o canal levou, para a trilha da TV: nenhuma tecla vai uma a uma ao registro, e esta soma é o que a API grava no lugar. Só vão a quem declara tv.rtc.v1. Sem resposta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.rtc.closed.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "reason"
      ],
      "properties": {
        "sessionId": {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        "reason": {
          "enum": [
            "requested",
            "connect_timeout",
            "idle",
            "failed",
            "replaced",
            "shutdown",
            "disconnected",
            "lifetime",
            "revoked",
            "cloud",
            "rescoped"
          ]
        },
        "tvKeys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "tvTexts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    }
  }
}
