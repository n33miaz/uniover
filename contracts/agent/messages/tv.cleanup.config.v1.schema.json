{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.cleanup.config.v1.schema.json",
  "title": "tv.cleanup.config.v1",
  "description": "API para agente: preferências da limpeza automática da TV.",
  "type": "object", "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 }, "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.cleanup.config.v1" }, "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" }, "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "type": "null" },
    "body": { "type": "object", "additionalProperties": false,
      "required": ["lightEnabled", "deepEnabled", "deepThresholdMb"],
      "properties": {
        "lightEnabled": { "type": "boolean" }, "deepEnabled": { "type": "boolean" }, "deepThresholdMb": { "type": "integer", "minimum": 64, "maximum": 512 }, "closeBackgroundApps": { "type": "boolean" }, "maintenanceEnabled": { "type": "boolean" },
        "focusEnabled": { "type": "boolean" }, "focusClosesBackground": { "type": "boolean" }, "shortAnimationsEnabled": { "type": "boolean" },
        "restrictedPackages": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$", "maxLength": 255 } }
      }
    }
  }
}
