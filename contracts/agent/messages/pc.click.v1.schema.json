{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.click.v1.schema.json",
  "title": "pc.click.v1",
  "description": "API para agente: clique do mouse. `down` e `up` existem para arrastar (toque e segure); sem `action` vale `click`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.click.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "button"
      ],
      "properties": {
        "button": {
          "enum": [
            "LEFT",
            "RIGHT",
            "MIDDLE"
          ]
        },
        "action": {
          "enum": [
            "CLICK",
            "DOUBLE",
            "DOWN",
            "UP"
          ],
          "default": "CLICK"
        }
      }
    }
  }
}
