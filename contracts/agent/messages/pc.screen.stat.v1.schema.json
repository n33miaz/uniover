{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.screen.stat.v1.schema.json",
  "title": "pc.screen.stat.v1",
  "description": "Agente para API: estatísticas de desempenho e medição da captura de tela ('s.stat'), enviadas quando há marca de medição ativa no canal WebRTC ('screen').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.screen.stat.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "bytes",
        "cpu",
        "privateMB"
      ],
      "properties": {
        "k": {
          "const": "s.stat"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "privateMB": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
