{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.rtc.candidate.v1.schema.json",
  "title": "pc.rtc.candidate.v1",
  "description": "API para agente: um candidato ICE que o app descobriu depois da oferta (reservado: o app espera a coleta terminar antes de oferecer, então hoje quase não é usado). O agente descarta candidatos .local.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.rtc.candidate.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "candidate"
      ],
      "properties": {
        "sessionId": {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sdpMid": {
          "type": "string",
          "maxLength": 32
        },
        "sdpMLineIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  }
}
