{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.wake.v1.schema.json",
  "title": "tv.wake.v1",
  "description": "API para agente: o app está aberto, então o agente aquece a sessão com a TV e renova o relógio de hibernação.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.wake.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": { "type": "object", "additionalProperties": false }
  }
}
