{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.rtc.offer.v1.schema.json",
  "title": "pc.rtc.offer.v1",
  "description": "API para agente: o app quer abrir o canal direto (WebRTC) com este PC. Leva a oferta SDP do app e o token de uso único e `tokenTtlSeconds` (a vida dele, contada pelo agente a partir do recebimento) e `maxLifetimeSeconds` (o teto da vida do canal inteiro, que a API tira do que resta do token de acesso da pessoa: o canal nunca vive mais que a sessão que o autorizou; o app abre outro antes do fim), que a primeira mensagem do canal precisa apresentar. O agente responde com pc.rtc.answer.v1 (mesmo correlationId) e command.result.v1. Só vai a quem declara a capacidade pc.rtc.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.rtc.offer.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "sdp",
        "token",
        "tokenTtlSeconds",
        "maxLifetimeSeconds"
      ],
      "properties": {
        "sessionId": {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        "sdp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32,86}$"
        },
        "tokenTtlSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        }
      }
    }
  }
}
