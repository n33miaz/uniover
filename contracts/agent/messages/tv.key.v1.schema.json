{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.key.v1.schema.json",
  "title": "tv.key.v1",
  "description": "API para agente: pressionar uma tecla da TV.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.key.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "enum": ["POWER","HOME","BACK","UP","DOWN","LEFT","RIGHT","OK","VOLUME_UP","VOLUME_DOWN","MUTE","CHANNEL_UP","CHANNEL_DOWN","PLAY_PAUSE"] }
      }
    }
  }
}
