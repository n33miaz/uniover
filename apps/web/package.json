{
  "name": "web",
  "version": "0.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/build-sw.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "audit:pwa": "node scripts/audit-pwa.mjs",
    "watch": "ng build --watch --configuration development",
    "serve:dist": "node e2e/server/static-server.mjs 4300",
    "lint": "ng lint && tsc -p tsconfig.sw.json --noEmit",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "e2e": "playwright test",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "dexie": "^4.4.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.1"
  },
  "overrides": {
    "handlebars": "^4.7.10"
  },
  "engines": {
    "node": "^24.15.0 || ^26"
  },
  "description": "Interface web (PWA) do UniOver"
}
