{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.cleanup.v1.schema.json",
  "title": "tv.cleanup.v1",
  "description": "API para agente: fecha os apps abertos na TV e libera memória pelo ADB, sem derrubar a conexão do controle remoto. O agente responde com command.result.v1 e, antes dele, com tv.cleanup.result.v1 (que devolve o requestId).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.cleanup.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": { "$ref": "../envelope.schema.json#/$defs/uuid" },
        "mode": { "enum": ["light", "deep", "manual"] },
        "foregroundPackage": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*([.][A-Za-z][A-Za-z0-9_]*)+$" }
      }
    }
  }
}
