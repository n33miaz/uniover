{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.screen.get.v1.schema.json",
  "title": "pc.screen.get.v1",
  "description": "API para agente: pedido de quadro da tela do PC no canal de dados WebRTC ('screen'). Manda um pedido por vez ('s.get'); o próximo só sai depois que o anterior foi respondido. 'monitor' é o id anunciado em 's.mon' (0 a 2147483647; omitido é o monitor principal). 'width' é a largura desejada do recorte em pixels físicos (128 a 1920, padrão 1280). 'fps' é o limite de quadros por segundo (1 a 10, padrão 5). 'marker' é a marca de medição embutida nos pixels (16 bits, 0 a 65535, padrão 0). 'reset' (padrão false) força envio do quadro sem comparar CRC e zera contadores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.screen.get.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k"
      ],
      "properties": {
        "k": {
          "const": "s.get"
        },
        "monitor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "width": {
          "type": "integer",
          "minimum": 128,
          "maximum": 1920,
          "default": 1280
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        },
        "marker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0
        },
        "reset": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
