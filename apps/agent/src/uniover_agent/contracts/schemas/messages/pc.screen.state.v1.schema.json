{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.screen.state.v1.schema.json",
  "title": "pc.screen.state.v1",
  "description": "Agente para API: estado do desktop do PC ('s.state'), enviado no canal WebRTC ('screen'). 'ok' é área de trabalho normal; 'locked' é estação bloqueada ou tela de logon/UAC; 'elevated' indica janela de administrador em foco.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.screen.state.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "state"
      ],
      "properties": {
        "k": {
          "const": "s.state"
        },
        "state": {
          "type": "string",
          "enum": [
            "ok",
            "locked",
            "elevated"
          ]
        }
      }
    }
  }
}
