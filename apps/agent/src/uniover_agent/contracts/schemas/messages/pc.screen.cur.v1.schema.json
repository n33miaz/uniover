{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.screen.cur.v1.schema.json",
  "title": "pc.screen.cur.v1",
  "description": "Agente para API: posição física do cursor do mouse no desktop virtual ('s.cur'), enviada no canal WebRTC ('screen').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.screen.cur.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "x",
        "y"
      ],
      "properties": {
        "k": {
          "const": "s.cur"
        },
        "x": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        }
      }
    }
  }
}
