{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/agent.logs.v1.schema.json",
  "title": "agent.logs.v1",
  "description": "Agente para API: o fim do registro do agente, já sem segredos (tokens, Authorization, códigos de pareamento, senhas). Sai antes do command.result.v1 do mesmo comando (correlationId = id do comando) e repete o requestId de agent.logs.request.v1. O texto cabe no limite de 64 KB do transporte: o agente tira as linhas mais antigas até caber e marca truncated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "agent.logs.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "text", "lines", "truncated", "at"],
      "properties": {
        "requestId": { "$ref": "../envelope.schema.json#/$defs/uuid" },
        "text": { "type": "string", "maxLength": 49152 },
        "lines": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "truncated": { "type": "boolean" },
        "at": { "$ref": "../envelope.schema.json#/$defs/timestamp" }
      }
    }
  }
}
