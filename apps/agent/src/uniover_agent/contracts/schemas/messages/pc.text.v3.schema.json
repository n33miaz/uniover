{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.text.v3.schema.json",
  "title": "pc.text.v3",
  "description": "API para agente: igual à `pc.text.v2` (apagar `erase` caracteres, digitar `text` e apertar `key`, nesta ordem e no mesmo toque no sistema), mas `text` pode levar quebra de linha (LF) e tabulação: é o texto colado com várias linhas, que chega inteiro num pedido em vez de um pedido por linha. O agente digita cada caractere em ordem e aperta Enter na quebra de linha e Tab na tabulação, cada aperto com a sua soltura no mesmo lote, então nenhuma tecla fica apertada entre um pedido e outro. CR e os demais caracteres de controle continuam proibidos (o app troca CRLF e CR por LF). `text` tem 1 a 200 caracteres. A API só a usa quando o texto tem LF ou Tab e só para o agente que declarou a capacidade `pc.text.v3`; para os demais o app manda as quebras como `key` da `pc.text.v2`, como sempre. `seq`, `epoch` e `target` como na `pc.text.v2`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.text.v3"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "$ref": "../envelope.schema.json#/$defs/operationId"
    },
    "deviceId": {
      "$ref": "../envelope.schema.json#/$defs/deviceId"
    },
    "deviceName": {
      "$ref": "../envelope.schema.json#/$defs/deviceName"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "erase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\u0000-\u0008\u000b-\u001f\u007f-\u009f]+$"
        },
        "key": {
          "enum": [
            "ENTER",
            "TAB"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "epoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "target": {
          "enum": [
            "browser",
            "spotify",
            "vlc"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "erase"
          ],
          "properties": {
            "erase": true
          }
        },
        {
          "required": [
            "text"
          ],
          "properties": {
            "text": true
          }
        },
        {
          "required": [
            "key"
          ],
          "properties": {
            "key": true
          }
        }
      ]
    }
  }
}
