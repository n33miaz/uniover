{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/agent.hello.v1.schema.json",
  "title": "agent.hello.v1",
  "description": "Agente para API ao conectar: versão do agente, capacidades e, opcionalmente, o que a manutenção remota mostra (sistema do PC, a TV que ele controla e o estado da auto-atualização).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "agent.hello.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["agentVersion", "capabilities"],
      "properties": {
        "agentVersion": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["transport.keepalive.v1", "agent.logs.v1", "agent.maintenance.v1", "agent.diagnostics.v1", "tv.cleanup.automatic.v1", "tv.light-settings.v1", "tv.focus-closes-background.v1", "tv.remote", "tv.adb", "tv.kind.android", "tv.kind.samsung", "tv.key.v3", "tv.power.off.v1", "tv.permission.v1", "tv.maintenance.v1", "tv.discovery.v1", "tv.key.INPUT", "tv.key.INFO", "tv.key.GUIDE", "tv.key.TOOLS", "tv.key.CHANNEL_LIST", "tv.key.PREVIOUS_CHANNEL", "tv.key.EXIT", "tv.key.PLAY", "tv.key.PAUSE", "tv.key.STOP", "tv.key.REWIND", "tv.key.FAST_FORWARD", "tv.key.RED", "tv.key.GREEN", "tv.key.YELLOW", "tv.key.BLUE", "tv.key.SUBTITLE", "tv.key.ASPECT", "tv.key.SLEEP", "tv.key.E_MANUAL"] }
        },
        "os": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tv": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "host"],
          "properties": {
            "kind": { "enum": ["android", "samsung"] },
            "host": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "update": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": {"enum": ["not_checked", "updating", "updated", "up_to_date", "failed", "blocked", "rolled_back"]},
            "installedSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "installedAt": {"$ref": "../envelope.schema.json#/$defs/timestamp"},
            "latestSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "checkedAt": {"$ref": "../envelope.schema.json#/$defs/timestamp"},
            "nextCheckAt": {"$ref": "../envelope.schema.json#/$defs/timestamp"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 200},
            "blockedSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "previousSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "rolledBack": {"type": "boolean"}
          }
        }
      }
    }
  }
}
