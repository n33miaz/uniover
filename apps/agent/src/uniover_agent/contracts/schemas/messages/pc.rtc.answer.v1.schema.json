{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.rtc.answer.v1.schema.json",
  "title": "pc.rtc.answer.v1",
  "description": "Agente para API: a resposta SDP à oferta do canal direto, com a impressão digital DTLS do agente. O correlationId é o id do pc.rtc.offer.v1. A API a entrega ao app pela rota autenticada; nada fica guardado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.rtc.answer.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "sdp"
      ],
      "properties": {
        "sessionId": {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        "sdp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  }
}
