{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.permission.request.v1.schema.json",
  "title": "tv.permission.request.v1",
  "description": "API para agente: pede à TV Samsung a permissão do UniOver (o aviso 'Permitir' na tela da TV). O agente responde logo com command.result.v1 (ok: o aviso foi pedido; erro: unsupported, tv_unreachable, permission_in_progress) e, quando a pessoa aceita, recusa ou o tempo acaba, manda tv.permission.v1. Só acontece por este pedido: o agente nunca pede a permissão sozinho.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "tv.permission.request.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false
    }
  }
}
