{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.media.query.v1.schema.json",
  "title": "pc.media.query.v1",
  "description": "API para agente: pede o que o Windows diz estar tocando agora (a sessão de mídia do sistema). O agente lê, manda `pc.media.state.v1` (com o `correlationId` deste pedido) e só depois responde `command.result.v1`; erros: `unsupported`, `failed`. Só leitura: nunca aperta tecla nem muda a reprodução. A API só a usa para o agente que declarou a capacidade `pc.media.state.v1`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.media.query.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "operationId": {
      "$ref": "../envelope.schema.json#/$defs/operationId"
    },
    "deviceId": {
      "$ref": "../envelope.schema.json#/$defs/deviceId"
    },
    "deviceName": {
      "$ref": "../envelope.schema.json#/$defs/deviceName"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
