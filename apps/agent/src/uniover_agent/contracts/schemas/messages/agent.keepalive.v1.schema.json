{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/agent.keepalive.v1.schema.json",
  "title": "agent.keepalive.v1",
  "description": "Agente para API: batimento sem efeito de negócio para manter o canal WebSocket ativo no proxy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "agent.keepalive.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "type": "null" },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loopLagMs": {
          "description": "Maior atraso do laço principal do agente desde o batimento anterior, em milissegundos. Opcional: os agentes anteriores não o mandam, e o agente só o manda à API que lista agent.keepalive.loop_lag em features.",
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    }
  }
}
