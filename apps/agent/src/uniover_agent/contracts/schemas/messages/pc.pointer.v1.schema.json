{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/pc.pointer.v1.schema.json",
  "title": "pc.pointer.v1",
  "description": "API para agente: movimento do mouse e rolagem já somados pelo app (vários toques do dedo viram uma mensagem). `dx`/`dy` são pixels relativos (positivo: direita e baixo); `scrollX`/`scrollY` estão em unidades de roda (120 = um clique da roda) e têm o sinal do Windows (positivo: direita e cima). O agente limita cada valor e executa sem responder (a API manda o movimento sem esperar resposta).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "source",
    "target",
    "ts",
    "correlationId",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "../envelope.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "pc.pointer.v1"
    },
    "source": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "target": {
      "$ref": "../envelope.schema.json#/$defs/endpoint"
    },
    "ts": {
      "$ref": "../envelope.schema.json#/$defs/timestamp"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "../envelope.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dx",
        "dy"
      ],
      "properties": {
        "dx": {
          "type": "integer",
          "minimum": -2000,
          "maximum": 2000
        },
        "dy": {
          "type": "integer",
          "minimum": -2000,
          "maximum": 2000
        },
        "scrollX": {
          "type": "integer",
          "minimum": -1200,
          "maximum": 1200
        },
        "scrollY": {
          "type": "integer",
          "minimum": -1200,
          "maximum": 1200
        }
      }
    }
  }
}
