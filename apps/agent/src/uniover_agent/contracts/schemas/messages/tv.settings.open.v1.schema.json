{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.settings.open.v1.schema.json",
  "title": "tv.settings.open.v1",
  "description": "API para agente: abrir na TV uma tela de configurações de uma lista fechada (WIFI: rede; SETTINGS: configurações). Só é enviada a agente que declara a capacidade tv.settings.open.v1 e só quando a pessoa toca no botão; o corpo nunca leva uma ação livre.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.settings.open.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["screen"],
      "properties": {
        "screen": { "enum": ["WIFI", "SETTINGS"] }
      }
    }
  }
}
