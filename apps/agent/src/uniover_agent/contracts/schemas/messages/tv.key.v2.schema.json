{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.key.v2.schema.json",
  "title": "tv.key.v2",
  "description": "API para agente: pressionar uma tecla da TV, com opção de pressão curta ou longa. Convive com tv.key.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.key.v2" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "enum": ["POWER","HOME","BACK","UP","DOWN","LEFT","RIGHT","OK","VOLUME_UP","VOLUME_DOWN","MUTE","CHANNEL_UP","CHANNEL_DOWN","PLAY_PAUSE","MENU","NUM_0","NUM_1","NUM_2","NUM_3","NUM_4","NUM_5","NUM_6","NUM_7","NUM_8","NUM_9","MEDIA_NEXT","MEDIA_PREVIOUS","INPUT"] },
        "direction": { "enum": ["SHORT", "START_LONG", "END_LONG"], "default": "SHORT" }
      }
    }
  }
}
