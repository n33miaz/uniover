{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniover.dev/contracts/agent/messages/tv.app.launch.v1.schema.json",
  "title": "tv.app.launch.v1",
  "description": "API para agente: abrir um app da TV por pacote Android ou por link (deep link).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "type", "source", "target", "ts", "correlationId", "body"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "../envelope.schema.json#/$defs/uuid" },
    "type": { "const": "tv.app.launch.v1" },
    "source": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "target": { "$ref": "../envelope.schema.json#/$defs/endpoint" },
    "ts": { "$ref": "../envelope.schema.json#/$defs/timestamp" },
    "correlationId": { "oneOf": [{ "$ref": "../envelope.schema.json#/$defs/uuid" }, { "type": "null" }] },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["package", "link"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\u0000-\u0020\u007f-\u009f]+$" }
          },
          "if": { "properties": { "kind": { "const": "package" } } },
          "then": { "properties": { "value": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z][A-Za-z0-9_]*([.][A-Za-z][A-Za-z0-9_]*)+$" } } },
          "else": { "properties": { "value": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]{1,31}://[^\u0000-\u0020\u007f-\u009f]+$" } } }
        }
      }
    }
  }
}
