{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": { "Enabled": false },
  "Messaging": { "IdlePollSeconds": 21600, "BatchSize": 20, "MaxAttempts": 8 },
  "Pwa": { "Modules": [ "tv", "treino" ] },
  "Modules": {
    "Identity": { "Version": "0.1.0" },
    "Tv": { "Version": "0.1.0" }
  }
}
