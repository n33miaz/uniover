{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": { "Enabled": false },
  "AuditPurge": { "FirstRunDelayMinutes": 10, "IntervalHours": 24 },
  "UNIOVER_OWNER_EMAIL": "",
  "UNIOVER_OWNER_PASSWORD": "",
  "Messaging": { "IdlePollSeconds": 21600, "BatchSize": 20, "MaxAttempts": 8 },
  "Pwa": { "Modules": [ "tv", "treino" ] },
  "Modules": {
    "Identity": {
      "Version": "0.1.0",
      "AccessMinutes": 10,
      "RefreshSlidingDays": 14,
      "RefreshAbsoluteDays": 90,
      "ReuseGraceSeconds": 3,
      "LockoutThreshold": 5,
      "LockoutBaseSeconds": 60,
      "LockoutMaxMinutes": 15,
      "MinPasswordLength": 10,
      "StreamTicketSeconds": 120,
      "Jwt": { "SigningKey": "", "PreviousSigningKey": "" },
      "Passkeys": { "RpId": "", "Origins": [], "ServerName": "UniOver" }
    },
    "Tv": {
      "Version": "0.1.0",
      "AgentId": "",
      "CommandTimeoutSeconds": 8,
      "HibernatingTimeoutSeconds": 15,
      "StateDebounceSeconds": 2,
      "Sse": { "MaxStreamsPerUser": 3, "KeepAliveSeconds": 15, "MaxLifetimeMinutes": 10, "SubscriberQueue": 64 }
    },
    "Training": {
      "Version": "0.1.0",
      "Import": {
        "Wger": { "BaseUrl": "https://wger.de", "DelayMs": 1000, "MaxItems": 1000 }
      },
      "Foods": { "OffContact": "" },
      "Photos": {
        "MaxAccountBytes": 104857600,
        "MaxAccountPhotos": 500,
        "Storage": { "Enabled": false, "ServiceUrl": "", "Region": "us-east-2", "Bucket": "", "AccessKey": "", "SecretKey": "" }
      }
    },
    "Devices": {
      "Version": "0.1.0",
      "TokenCacheSeconds": 30,
      "Transport": {
        "RequestTimeoutSeconds": 5,
        "QueueCapacity": 64,
        "MaxMessageBytes": 65536,
        "KeepAliveSeconds": 20,
        "ApplicationKeepAliveSeconds": 25,
        "ReconnectGraceSeconds": 3,
        "RefusalLimit": 5,
        "RefusalWindowSeconds": 60,
        "CloseGraceSeconds": 2,
        "Sse": { "MaxStreamsPerUser": 3, "KeepAliveSeconds": 15, "MaxLifetimeMinutes": 10, "SubscriberQueue": 64 }
      },
      "Pairing": {
        "ExpiresMinutes": 10,
        "MinPollIntervalSeconds": 5,
        "MaxActive": 5,
        "MaxPerGuest": 2,
        "RequireStepUp": true
      }
    }
  }
}
