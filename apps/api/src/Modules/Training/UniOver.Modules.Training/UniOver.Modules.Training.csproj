<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Mesma versão do EF Core central: sem isto o provedor do Npgsql puxa uma Relational mais antiga e os projetos
         que referenciam o módulo acusam conflito de versão (o Design, privado, só alinha o próprio módulo). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="JpegLibrary" />
    <!-- Só para gerar as migrations e o bundle com o dotnet ef; não vai para quem referenciar o módulo. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniOver.Modules.Training.Contracts\UniOver.Modules.Training.Contracts.csproj" />
    <ProjectReference Include="..\..\..\UniOver.SharedKernel\UniOver.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\UniOver.BuildingBlocks.Persistence\UniOver.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\..\UniOver.BuildingBlocks.Web\UniOver.BuildingBlocks.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A semente do catálogo viaja dentro do assembly: nada de ler arquivo em tempo de execução. O nome do arquivo termina
         em ".pt-br.json" e o MSBuild o trataria como recurso de idioma (assembly satélite): WithCulture="false" o mantém no
         assembly principal. -->
    <EmbeddedResource Include="Catalog\Seed\exercises.pt-br.json" WithCulture="false" LogicalName="UniOver.Modules.Training.Catalog.Seed.exercises.pt-br.json" />
    <!-- Modelos de rotina prontos: também embutidos no assembly, lidos só quando alguém os pede. -->
    <EmbeddedResource Include="Catalog\Seed\routine-templates.json" LogicalName="UniOver.Modules.Training.Catalog.Seed.routine-templates.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UniOver.Modules.Training.Tests" />
    <!-- Os testes de integração leem o banco e a semente do módulo sem abrir a API pública. -->
    <InternalsVisibleTo Include="UniOver.IntegrationTests" />
  </ItemGroup>
</Project>
